# DarkWatch Intelligence & Telemetry Suite - Environment Variables Example
# Copy this file to .env and replace with your secure credentials.
# NEVER commit the actual .env file to version control.

# Administrator Dashboard Authentication
DARKWATCH_ADMIN_USER=admin
DARKWATCH_ADMIN_PASSWORD=change_this_to_a_strong_password_in_production

# Flask Web Server Secret Key (used to cryptographically sign session cookies)
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
DARKWATCH_SESSION_SECRET=your_random_64_character_hex_string_here

# AES-256 Encryption Key for Fernet Log Protection (Optional override)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DARKWATCH_ENCRYPTION_KEY=

# Server Network Configuration
DARKWATCH_HOST=127.0.0.1
DARKWATCH_PORT=5000
DARKWATCH_AUTH_REQUIRED=true

# Alert & Notification Settings
DARKWATCH_CAPTURE_INTERVAL=30
